# =====================================================================
# Tony Voice Assistant — Environment Configuration Template
# Copy this file to .env and insert your API keys:
#   copy .env.example .env
# =====================================================================

# Primary Fast Brain (Groq is required for fallback / primary fast inference)
GROQ_API_KEY=

# Multi-Provider Vision & LLM APIs
GEMINI_API_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
GITHUB_TOKEN=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=

# Optional: Telegram Link for Remote Notifications / Interaction
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Default Location / Weather
TONY_CITY=
